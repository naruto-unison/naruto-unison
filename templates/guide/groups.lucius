h2 {
    text-transform: none !important;
    margin-top: 2em;
    margin-bottom: 0.5em !important;
    font-weight: normal;
}

main {
    text-align: center;
}

.char {
    margin: 1px -2px 0px -2px !important;
    width: 50px;
    height: 50px;
    position: relative;

    &:hover {
        outline-color: var(--action);
        z-index: 2;
    }
}
