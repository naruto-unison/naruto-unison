<img .char.head src=/img/ninja/#{ident}/icon.jpg alt="Character icon">
<h1>
  #{name}#{category}
<p>
  #{Parse.desc bio}
$maybe mission <- mmission
  <h2>
    Mission
  <ul>
    $forall (goal@Reach{desc, reach}, progress) <- mission
      <li>
        $maybe char <- Goal.character goal
          As ^{Link.character char}: #
        #{Parse.desc desc} #
        $if progress < reach
          <span .incomplete>
            (#{progress}/#{reach})
        $else
          <span .complete>
            (#{reach}/#{reach})

$forall skillGroup <- skills
  <section>
    $forall Skill{charges, classes, cooldown, cost, desc, dur, name} <- separate skillGroup
      <section>
        <aside>
          <img .char src=/img/ninja/#{ident}/#{shorten(name)}.jpg alt="Skill icon">
        <div>
          <h3>
            #{name}
          #{Parse.desc desc}
          <p .skillClasses>
            #{skillClasses classes}
          <dl>
            <dt>Duration
            <dd>#{dur}
            $if cost /= mempty
              <dt>Cost
              <dd>#{cost}
            $if cooldown /= 0
              <dt>Cooldown
              <dd>#{cooldown}
            $if charges /= 0
              <dt>Charges
              <dd>#{charges}
