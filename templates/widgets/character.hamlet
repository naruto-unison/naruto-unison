<div .charbox>
  <div>
    <img data-char=#{ident} .char.head src=/img/ninja/#{ident}/icon.jpg>
  <div>
    ^{Link.character char}
    <ul>
      $forall skillGroup <- char.skills
        <li>
          $forall Skill{name} <- toList skillGroup
            <skill data-char=#{ident} data-skill=#{name}>
