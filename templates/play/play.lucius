:root {
    --action-available: #fff;
    --action-cancel: #ff0000;
    --char-border: #111;
    --palette-blue: #00a;
    --palette-red: #a00;
    --select-border: #dc2e3c;
    --war-blue: #007acc;
    --war-red: #e00;
    --war-purple: purple;
}

@keyframes expand {
    0% {
        width: 0;
    }
}

@keyframes fadeIn {
    0% {
        opacity: 0;
    }
    100% {
        opacity: 1;
    }
}
@keyframes fadeOut {
    0% {
        opacity: 1;
    }
    100% {
        opacity: 0;
    }
}

a:hover {
    text-decoration: none !important;
}

article {
    -webkit-user-select: text;
    user-select: text;
}

body {
    background: url("/img/bg/silhouette.jpg") no-repeat center center/cover !important;
    overflow: hidden !important;
}

body,
button {
    font-family: "Trebuchet MS", sans-serif;
}

button {
    appearance: none;
    background: unset;
    border: unset;
    margin: unset;
    padding: unset;

    &:hover {
        background: initial;
    }
}

dl {
    width: 100%;
    margin-bottom: 0 !important;
}
dd {
    margin-bottom: 0 !important;
}

h1,
h2,
h3,
h4,
h5,
h6 {
    aside {
        float: right;
        font-weight: normal !important;
        opacity: 0.9;
    }
}

main {
    display: flex;
}

menu {
    list-style-type: none;
    padding: 0;
    margin-bottom: 0;
}

p {
    margin: 0;
}

#avatars button:disabled,
.queueing #charSelect,
.chars .char:disabled,
.dead,
.ghost.charbarrier,
.ghost.chardefense,
.ghost.detail img {
    filter: grayscale(0.8) !important;
}

.dna::after,
.locked::after {
    margin-left: 0.15em;
    vertical-align: middle;
    filter: saturate(0) brightness(0);
    line-height: 0;
    font-weight: normal;
}
.dna::after {
    content: "🧬";
}
.locked::after {
    content: "🔒";
}

.chars .char[role="button"]:hover,
.alts .char:hover {
    outline: 2px solid var(--action) !important;
    filter: none !important;
}

#avatars button,
.charmove,
button.chakra,
.face {
    border: 1px solid var(--action-available);

    &:hover {
        border-color: var(--action);
    }

    &:disabled {
        border-color: #000 !important;
    }
}

.act:hover {
    border: 1px solid var(--action-cancel) !important;
}

.account {
    display: flex;
    align-items: end;
    flex-grow: 1;

    section {
        color: #eee;
        display: inline-block;
        vertical-align: top;
        width: 10em;
        text-transform: uppercase;
        margin: -1px 6px;
        flex-grow: 1;
    }
}
#account0 {
    text-align: right;
}
#account1 {
    text-align: left;
    right: 0;
    flex-direction: row-reverse;
}

#accountSettings {
    padding: 0.5em 1.3em;

    label {
        display: block;

        span {
            min-width: 11em;
            display: inline-block;
            font-weight: bold;
        }
    }

    input {
        margin-right: 0.5em;

        &[type="text"] {
            width: 15em;
        }
    }
}

.actcost {
    position: absolute;
    left: 1px;
    bottom: -4px;

    .chakra {
        margin-bottom: 3px;
        margin-left: 1px;
    }
}

.alts {
    width: 75px;
    position: absolute;
    bottom: -1px;
    left: -65px;
    font-size: 16px;

    .char {
        outline: 1px solid #000;

        &.on {
            outline: 2px solid #fff !important;
            cursor: unset !important;
        }
    }

    .charWrapper {
        button {
            bottom: 1px;
        }
    }
}

.avatar {
    border: 2px solid #333;
    width: 75px;
}

#avatars {
    height: 209px;
    overflow-y: scroll;
    border: 2px solid #000;
    margin-top: 0.5em;
    border-left: none;
    border-right: none;
    padding-left: 1px;
    text-align: center;

    button {
        border-width: 2px;
        margin: -2px 1px 4px 1px;
    }

    img {
        width: 45px;
        height: 45px;
    }
}

#bg {
    position: absolute;
    inset: -10px;
    background-size: cover;
    background-position: center;
    z-index: -2;
}

#bottom {
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
    display: flex;
    flex-grow: 1;

    article {
        text-align: left;
        font-size: 13px;
        padding: 5px;
        line-height: 1.22;
        border: 2px solid #444;
        flex-grow: 100;
        max-width: 900px;

        aside {
            position: relative;
        }

        li {
            margin-bottom: -0.25em;
        }

        span {
            display: block;
        }

        section {
            flex-grow: 1;
        }

        > section {
            display: flex;
            margin-bottom: 0.25em;

            > div {
                position: relative;
            }
        }

        ul {
            font-weight: bold;
            padding-left: 1em;
            margin: 1em 0 0.5em 0;
        }

        .char {
            margin-bottom: 0;
            height: 75px;
        }

        .remove {
            color: var(--palette-blue);
        }

        .trap {
            color: var(--palette-red);
        }
    }

    h3 {
        font-weight: bold;
        font-size: 16px;
        margin: 0;
    }

    h4 {
        margin-top: 3px;
        margin-bottom: 0;
    }
}

#browse {
    display: flex;
    position: absolute;
    top: 219px;
    left: 0;
    right: 0;

    button {
        flex-grow: 1;
        margin: 0 2px;
        padding: 0.1em;
        border: 2px solid #fff;
        border-top: 0px;
        text-transform: uppercase;

        &:disabled {
            border-color: var(--select-border);
            color: unset;
        }
    }
}

#cancel {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin: 50px auto 0 auto;
    width: 187px;
    height: 27px;
}

#center,
.player {
    position: absolute;
    top: 20px;
}

#center {
    color: #222;
    width: max-content;
    margin: auto;
    font-family: Verdana, sans-serif;
    font-size: 1.3em;
    left: 0;
    right: 0;

    > button {
        color: #000;
        -webkit-user-select: none;
        user-select: none;
        margin: 0.15em;
        -webkit-user-select: none;
        user-select: none;
        text-transform: uppercase;
        font-size: 20px;
        text-align: center;
        width: 100%;

        &:disabled {
            opacity: 0.5;
        }

        &:enabled:hover {
            color: var(--palette-blue);
        }
    }
}
#spend {
    display: flex;
    align-items: center;

    button {
        margin: 0;
    }

    div {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    div:first-of-type {
        margin-left: 1.5em;
    }

    span {
        margin-left: 0.2em;
        display: block;
        font-size: 0.9em;
        width: 1.5em;
    }

    .chakra {
        height: 0.8em;
        width: 0.8em;

        &:enabled {
            color: var(--action-available);

            &:hover {
                color: var(--palette-blue);
            }
        }
    }

    .less,
    .more {
        font-size: 0.8em;

        &:disabled {
            opacity: 0;
            pointer-events: none;
        }
    }
    .less::after {
        content: "▼";
    }
    .more::after {
        content: "▲";
    }
}

.charBanner {
    button {
        background-color: var(--button-bg);
        border-radius: 0;
        border: 1px solid var(--action);
        font-size: 0.8em;
        margin: -0.1em 0.5em;
        padding: 0.1em 1em;
        text-transform: uppercase;
        vertical-align: top;

        &:hover {
            background-color: var(--button-hover);
        }
    }
}

#controls {
    display: flex;

    .switch {
        border-color: #fff;
    }
}

.char {
    &:disabled {
        outline-color: #555 !important;
    }

    &.locked {
        opacity: 0.75;
        outline-color: #999;
    }
    &.locked.buy {
        outline-color: #0a0;
        outline-width: 2px;
    }
}

.chars,
#vs {
    border: 9px solid var(--select-border);
    -webkit-user-select: none;
    user-select: none;
}

.chars {
    text-align: center;
    position: absolute;
    bottom: 30px;
    left: 55px;
    right: 55px;
    padding: 5px;
    padding-top: 3px;

    .char {
        margin: 4px;
        width: 60px;
        height: 60px;
        outline-color: #000;
    }
}

#forTeam {
    border-left: none;
    border-right: none;
    height: 202px;
}

#forVs {
    flex-grow: 1;

    top: 250px;
    left: 0;
    right: 0;

    input,
    textarea {
        display: block;
        width: 100%;
        resize: none;
        margin: 5px 0 10px 0;
        box-sizing: border-box;
    }

    textarea {
        height: 25em;
    }

    .charScroll {
        overflow-y: unset;
        margin-top: -3px;
    }
}

.charicon {
    border: 2px solid var(--char-border);
}

.charWrapper {
    display: inline-block;
    position: relative;

    button {
        box-sizing: initial;
        width: 1em;
        height: 1em;
        position: absolute;
        line-height: 0;
        left: 5px;
        bottom: 5px;
        border-radius: 100%;
        border: 1px solid #000;
    }

    button:hover {
        transform: scale(1.1);
    }

    div {
        border-radius: 100%;
        width: 15px;
        height: 15px;
        position: absolute;
        bottom: 2px;
        right: 2px;
        background: var(--war-color);
        border: 2px solid #000;
    }

    .add {
        background-image: url("/img/ui/select/add.svg");
    }

    .remove {
        background-image: url("/img/ui/select/remove.svg");
    }
}

.charhealthbar {
    height: 15px;
    background-color: var(--char-border);
    position: relative;

    span,
    div {
        transition:
            left 1s,
            right 1s,
            top 1s,
            bottom 1s,
            width 1s;
    }

    span {
        font-size: 9px;
        color: #fff;
        position: absolute;
        left: 0;
        right: 0;
        top: 2px;
    }

    div {
        position: absolute;
        top: 0;
        bottom: 0;
        border: 2px solid var(--char-border);
        box-sizing: border-box;
        width: 0;
        animation: expand 0.5s linear;
    }

    .charbarrier {
        background-color: #e00;

        &:hover {
            border-color: var(--palette-red);
        }
    }

    .chardefense {
        background-color: #08b;
        z-index: 2;

        &:hover {
            border-color: var(--palette-blue);
        }
    }

    .charhealth {
        animation: none;
        background-color: #0a0;
    }
}
#player0 .charhealthbar {
    margin-right: 4px;

    div {
        left: 0;
    }

    span {
        left: 100%;
    }
}
#player1 .charhealthbar {
    margin-left: 4px;

    div {
        right: 0;
    }

    span {
        right: 100%;
    }
}

.charmove {
    margin: 0 6px;
    display: inline-block;
    position: relative;
    transition: 0.2s filter;

    .cd {
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        color: #fff;
        text-align: center;
        margin-top: -1em;
        font-size: 3em;
        -webkit-text-stroke: 2px rgba(0, 0, 0, 0.8);
    }
}

.charmoves {
    display: inline-block;
    vertical-align: top;
    height: 79px;
}

.charScroll {
    height: 100%;
    text-align: center;
    overflow: hidden;
    font-size: 20px;

    img {
        width: 60px;
    }
}

#charSelect {
    max-width: 942px;
    position: relative;
    height: 100%;
    margin: auto;

    > article {
        box-sizing: border-box;
        border: 1px solid #000;
        position: absolute;
        bottom: 275px;
        font-family: Verdana, sans-serif;
        font-size: 12px;
        padding: 5px 10px;
        width: 100%;
        z-index: 1;

        h4 {
            margin-bottom: -0.1em !important;
        }

        h3 {
            margin-top: 0.2em !important;
            font-size: 18px;
            font-weight: bold;

            .char {
                width: 60px;
                height: 60px;
                float: right;
                margin-top: 0;
            }
        }

        li {
            margin-top: 0;
        }

        p {
            line-height: 1.3em;
        }
        > p {
            min-height: 40px;
        }

        > section {
            > div {
                float: left;
                position: relative;
            }

            > p {
                min-height: 43px;
                margin: 0.1em 0.1em 0 0.1em;
            }
        }

        .char {
            height: 50px;
            width: 50px;
            margin: 3px 5px;
        }
    }

    > header {
        width: 100%;
        padding-top: 15px;
        display: flex;
    }
}

#charSelect .chakra,
#top .chakra {
    margin-left: 0.2em;
    margin-right: 0;
    font-size: 0.75em;
}

.detail {
    display: inline-flex;
    text-align: center;
    margin: 1px;

    div {
        border: 1px solid #000;
        position: relative;

        span {
            position: absolute;
            right: 1px;
            bottom: 0;
        }
    }

    img {
        width: 30px;
        width: 30px;
    }

    .amount {
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        color: #fff;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        -webkit-text-stroke: 2px rgba(0, 0, 0, 0.8);
    }
}
.channels {
    margin-bottom: 2px;
    display: flex;

    .detail {
        flex-direction: column-reverse;
    }
}
.statuses {
    margin-top: 2px;
    display: flex;

    .detail {
        flex-direction: column;
    }
}
.ghost {
    --ghost: #666;
    color: var(--ghost);
    opacity: 0.65;

    div {
        border-color: var(--ghost);
    }
}
.invis {
    opacity: 0.65;
}
.remove div,
.action div {
    border-color: var(--palette-blue);
}

.trap div,
.control div {
    border-color: var(--palette-red);
}

#endgame {
    position: absolute;
    top: 242px;
    text-align: center;
    margin: auto;
    left: 0;
    right: 0;

    dl {
        margin-top: 0.5em;
        text-transform: uppercase;
        line-height: 1.5em;
        font-size: 1.3em;
    }

    dd {
        text-align: left;
    }
    dd::before {
        content: "+";
    }

    dt {
        font-weight: normal;
        text-align: right;
    }

    dd,
    dt {
        float: none;
        width: 49%;
        display: inline-block;
        padding: 0 0.25em;
        margin: 0;
        box-sizing: border-box;
        opacity: 0;
        animation: fadeIn 0.5s linear 0s 1 normal forwards;
    }

    /* TODO there must be a better option */
    dt:nth-child(1),
    dd:nth-child(2) {
        animation-delay: 0s;
    }
    dt:nth-child(3),
    dd:nth-child(4) {
        animation-delay: 0.5s;
    }
    dt:nth-child(5),
    dd:nth-child(6) {
        animation-delay: 1s;
    }
    dt:nth-child(7),
    dd:nth-child(8) {
        animation-delay: 1.5s;
    }
    dt:nth-child(9),
    dd:nth-child(10) {
        animation-delay: 2s;
    }
    dt:nth-child(11),
    dd:nth-child(12) {
        animation-delay: 2.5s;
    }
    dt:nth-child(13),
    dd:nth-child(14) {
        animation-delay: 3s;
    }
    dt:nth-child(15),
    dd:nth-child(16) {
        animation-delay: 3.5s;
    }
    dt:nth-child(17),
    dd:nth-child(18) {
        animation-delay: 4s;
    }
    dt:nth-child(19),
    dd:nth-child(20) {
        animation-delay: 4.5s;
    }
    dt:nth-child(21),
    dd:nth-child(22) {
        animation-delay: 5s;
    }

    p {
        font-size: 6em;
        font-family: Helvetica, sans-serif;
        color: #fff;
        -webkit-text-stroke: 2px #000;
        text-shadow: 0 0 5px #000;
        text-transform: uppercase;
    }
}

#error {
    color: var(--danger);
    position: absolute;
    bottom: 10px;
    left: 10px;
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid #fff;
}

#forfeit:hover {
    color: var(--danger);
}

.inactive {
    color: var(--danger);
    font-size: 2em;
}

#main {
    height: 100%;
    box-sizing: border-box;
    margin: 0 3em;
}

#main,
#accountSettings {
    -webkit-user-select: none;
    user-select: none;
}

#mainsite {
    border-color: #000 !important;
}

#nextPage {
    right: -56px;
}
#prevPage {
    left: -56px;
}

.nextSkill,
.prevSkill {
    font-size: 15px;
    position: absolute;
    bottom: 5px;
    color: #000;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.75);
    text-shadow: 0 0 1px rgba(255, 255, 255, 0.75);

    &:hover {
        color: var(--action);
    }
}
.nextSkill {
    right: 5px;

    &::after {
        content: "▶";
    }
}
.prevSkill {
    left: 5px;

    &::after {
        content: "◀";
    }
}

.ninja {
    margin-bottom: 15px;
}
.details {
    font-family: Verdana, sans-serif;
    height: 52px;
    color: #eee;
}
.face {
    z-index: 5;
    position: relative;
    float: left;

    &.targetable {
        background-color: #0f0;

        img {
            border-color: rgb(19, 112, 19);
            opacity: 0.75;
        }
    }
    &.untargetable {
        background-color: rgb(170, 0, 0);

        img {
            border-color: rgb(119, 1, 1);
            opacity: 0.75;
        }
    }

    button:enabled {
        border-color: var(--action-available) !important;
    }
}

#playButtons {
    margin: -3px;
    align-self: end;
    min-width: 5em;
}
.playButton,
#updateButton,
#logoutButton {
    margin: 3px;
    padding: 4px 3px 2px 3px;
    border: 2px solid var(--select-border);
    color: #000;
    text-transform: uppercase;
    font-size: 15px;
    text-align: center;

    &:hover {
        border: 2px solid var(--action);
    }

    &:disabled {
        border: 2px solid #999 !important;
        color: #666;
    }
}
#updateButton,
#logoutButton {
    width: 6em;
    margin-top: 0.5em;
}
#updateButton {
    margin-left: 0;
    float: left;
}
#logoutButton {
    margin-right: 0;
    float: right;
}
.playButton {
    display: block;
    text-decoration: none;
    height: 17px;
    box-sizing: initial;
    width: 100%;
}

.player {
    height: 100%;
    transition: 0.5s all;
}

#player0 {
    right: calc(50% + 200px);
    text-align: left;

    .charbarrier,
    .chardefense {
        border-left: none;
    }

    .face {
        float: left;
    }
}
#player1 {
    left: calc(50% + 200px);
    text-align: right;

    .channels,
    .statuses {
        flex-direction: row-reverse;
    }

    .charbarrier,
    .chardefense {
        border-right: none;
    }

    .face {
        float: right;
    }
}
#account1 .charicon,
#player1 .charicon {
    transform: rotateY(180deg);
}

#playqueue {
    height: 81px;
    text-align: center;

    .act {
        position: relative;
        border: 1px solid var(--action-available);
        margin: 2px;
        display: inline-block;
    }
}

.progressbar-text {
    color: #fff !important;
    font-size: 4em;
    font-family:
        Courier New,
        monospace;
    transition: all 1s;
    left: 32% !important;
    top: 5% !important;
}

.queueing #charSelect {
    pointer-events: none;
}

#ready {
    color: #eee;
    width: 238px;
    margin: auto;
    margin-top: 3px;
    border: 1px solid #000;
    padding: 3px 0;
    position: relative;
    text-transform: uppercase;

    &:disabled {
        opacity: 1 !important;
    }

    &:enabled:hover {
        border-color: var(--action-available);
    }

    svg {
        display: block;
        width: 100%;
        height: 100%;
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: #161616;
    }
}

.redblue {
    --war-color: purple;
}
.red {
    --war-color: #e00;
}
.blue {
    --war-color: #007acc;
}
.redblue,
.red,
.blue {
    color: var(--war-color);
}

#return {
    width: 5em;
    margin: auto;
    font-size: 1.3em;
    border: 2px solid var(--select-border);
    padding-bottom: 0.5em;
}

#searching {
    border-radius: 100%;
    width: 160px;
    height: 160px;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin: -130px auto auto;
    border: 3px solid #000;
    overflow: hidden;
    z-index: 10;

    img {
        width: 180px;
        margin-left: -10px;
        margin-top: -10px;
    }
}

.select {
    img {
        width: 75px;
        height: 75px;
        outline: 2px solid #000;
    }

    .char {
        margin: 0 4px 0 6px;

        &[role="button"]:hover {
            outline: 2px solid var(--action-cancel);
        }
    }
}

.scroll {
    position: absolute;
    top: -17px;

    div {
        position: absolute;
        background-color: #222;
        display: block;
        inset: 20%;
    }

    &:hover div {
        background-color: var(--action);
    }

    img {
        position: relative;
    }
}

.skillClasses {
    font-size: 12px;
    display: inline;
    margin: 0;
    margin-left: 10px;
}
#game .skillClasses {
    display: block;
    font-size: 1em;
    margin-left: 0;
}

#teamButtons {
    width: 256px;
    height: 75px;
    margin: 2px 0 9px 0;
    font-size: 24px;

    .charWrapper button {
        bottom: 1px;
        left: 7px;
    }
}

#teamContainer {
    width: 263px;
    text-align: right;
    display: flex;
    flex-direction: column;

    .charWrapper div {
        bottom: -2px;
    }
}

#userBox,
#underTeam {
    border: 2px solid #000;
}

#underTeam {
    margin: -1px 0 0 3px;
    display: flex;
    border-right: none;
    z-index: 1;
    padding: 5px 13px 5px 5px;

    .chakra {
        height: 0.9em;
        width: 0.9em;
        margin-right: 0.45em;
    }

    span {
        flex-grow: 1;

        &:first-child {
            flex-grow: unset;
        }
    }
}

#userBox {
    width: 251px;
    padding: 5px 10px 5px 10px;
    line-height: 1.2;
    margin-left: -2px;
    text-align: left;
    font-size: 14px;
    position: relative;
    -webkit-user-select: text;
    user-select: text;

    dt {
        width: 4.8em;
    }
    dd {
        margin-left: 4.8em;
    }

    h4,
    p {
        margin: 0;
    }

    strong {
        width: 5em;
        display: inline-block;
    }

    .dna {
        float: right;
    }
}

#userfail {
    color: var(--danger);
    width: inherit;
    margin-left: 0.5em;
}

.userForm {
    text-align: center;
    padding-right: 8px;

    a {
        color: var(--palette-blue);

        &:hover {
            color: #000;
        }
    }

    div {
        margin-top: 4px;
    }

    input {
        width: 100%;
    }
}
#registerForm,
#loginForm {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
}

.userimg {
    border: 2px solid #000;
    position: absolute;
    right: 5px;
    bottom: 5px;
}

#volume {
    width: 15px;
    height: 15px;
    position: fixed;
    top: 10px;
    right: 20px;
    z-index: 2;
}

#vs {
    display: flex;
    margin-top: 15px;
    margin-bottom: -9px;
    padding: 10px;
    min-height: 75px;

    nav {
        display: flex;
    }

    button,
    input,
    span {
        align-self: center;
    }

    button {
        width: 6em;
    }

    span {
        margin: 0 0.5em 0 1em;
    }

    &.vsPractice {
        border-bottom: none;
    }
}

.war {
    text-align: center;

    section {
        display: flex;
    }

    div {
        float: none !important;
        flex-grow: 1;
        padding: 0.67em 0;
    }

    h1,
    div {
        font-size: 1.75em;
    }

    > p {
        margin-top: 0.5em;
        font-size: 1.25em;
    }
}

@media (max-width: 1300px) {
    .charhealthbar {
        margin-top: -13px;
        width: 293px;
    }

    .player {
        width: 383px;
    }

    #player0 .charhealthbar {
        margin-left: 79px;
        margin-right: auto;
    }

    #player1 .charhealthbar {
        margin-left: auto;
        margin-right: 79px;
    }

    .charmove {
        width: 62px;
        height: 62px;

        img {
            width: 100%;
            height: 100%;
        }
    }
}

@media (max-width: 1173px) {
    #center {
        left: initial;
        right: 140px;
    }

    .player {
        top: 125px;

        > section {
            margin-bottom: 3px;
        }
    }

    #player0 {
        right: unset;
        left: 25px;
    }

    #player1 {
        left: unset;
        right: 25px;
        width: 200px;

        .charhealthbar {
            margin-right: 0 !important;
            width: 81px;
            z-index: 10;
        }

        .charmove {
            display: none;
        }
    }

    #top {
        > article {
            left: 100px;
            right: 100px;
        }

        > section {
            width: 100px;

            p,
            > section {
                display: none;
            }
        }
    }
}

@media (max-width: 860px) {
    #vs nav {
        flex-direction: column;
    }
}

@media (max-width: 830px) {
    .playButton {
        font-size: 0.8em;
    }
    #userBox {
        width: 240px;
    }
    .playButton::before {
        content: none;
    }
}
@media (max-width: 760px) {
    #userBox {
        width: 160px;

        .userimg {
            display: none;
        }
    }
}
@media (max-width: 680px) {
    #userBox {
        width: 168px;
    }
    .playButton::after {
        content: none;
    }
}
@media (max-width: 630px) {
    .playButton {
        font-size: 0.6em;
    }
    #userBox {
        width: 154px;
    }
}
@media (max-width: 590px) {
    #userBox {
        font-size: 12px;
        width: 136px;
    }
}
@media (max-height: 770px) {
    .characters {
        bottom: 5px;
        height: 173px;

        .char {
            width: 50px;
            height: 50px;
        }
    }

    #charSelect {
        > article {
            bottom: 200px;
            font-size: 0.7em;

            .char {
                width: 40px;
                height: 40px;
            }

            > p {
                min-height: revert;
            }

            > section > p {
                min-height: 28px;
            }
        }

        > header {
            padding-top: 5px;
        }
    }

    .charBanner img.char {
        width: 50px;
        height: 50px;
    }
}

@media (max-width: 560px) {
    a.playButton {
        font-size: 0.7em;
        height: 10px;
        line-height: 0.8em;
    }

    .chars .char {
        width: 45px;
        height: 45px;
    }

    #forTeam {
        height: 104px;
        bottom: 10px;

        nav {
            display: none;
        }
    }

    .charScroll {
        overflow-y: scroll;
    }

    #charSelect {
        margin: 0 10px;

        > article {
            font-size: 0.7em;
            bottom: 150px;

            .char {
                height: 30px;
                width: 30px;
            }
        }

        h3 {
            font-size: 14px;

            img.char {
                width: 40px;
                height: 40px;
            }
        }

        > header {
            padding-top: 0;
            margin-top: -5px;
        }
    }
    h4,
    #charSelect > article .skillClasses {
        font-size: 0.8em;
    }

    #teamButtons {
        height: 60px;

        img {
            width: 60px;
            height: 60px;
        }
    }

    #userBox,
    #underTeam {
        display: none;
    }

    #volume {
        top: 100px;
    }
}
