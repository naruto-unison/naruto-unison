<table>
  <thead>
    <tr>
      <th>
        Character
      <th>
        Win Rate
      <th>
        Pick Rate
  <tbody>
    $forall UsageRate{character, pickRate, winRate} <- usageRates
      <tr>
        <td>
          ^{Link.character character}
        <td>
          #{showRate winRate}
        <td>
          #{showRate pickRate}
