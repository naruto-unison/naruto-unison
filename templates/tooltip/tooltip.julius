"use strict";

/** @typedef {"blood" | "gen" | "nin" | "tai" | "rand"} Chakra */

/** @typedef { [Chakra]: number } Chakras */

/**
 * @typedef Skill
 * @property {string}   name
 * @property {string}   desc
 * @property {string[]} classes
 * @property {number}   cooldown
 * @property {number}   charges
 * @property {number}   dur
 * @property {Chakras}  cost
 */

/**
 * @typedef Character
 * @property {string}    name
 * @property {string}    bio
 * @property {string[]}  groups
 * @property {Skill[][]} skills
 * @property {number}    price
 * @property {string}    category
 * @property {string}    ident
 */

/**
 * @typedef SkillElements
 * @property {HTMLElement[]} header
 * @property {HTMLElement[]} article
 * @property {string}        desc
 */

/**
 * @typedef Tooltip
 * @property {HTMLElement} header
 * @property {HTMLElement} article
 */

document.addEventListener("DOMContentLoaded", () => {
    const chars = new Map(characters.map((character) => [character.ident, character]));

    /**
     * @param {HTMLElement} el
     * @return {Character|undefined}
     */
    function findCharacter(el) {
        return chars.get(el.dataset.name);
    }

    /**
     * @param {HTMLElement} el
     * @return {Skill|undefined}
     */
    function findSkill(el) {
        const character = findCharacter(el);
        const skillName = el.innerText;
        return character && character.skills.flat().find(({ name }) => name == skillName);
    }

    /**
     * @param {Character} x
     * @returns {string}
     */
    function formatCharacterName({ category, name }) {
        switch (category) {
            case "Shippuden":
                return name + " (S)";
            case "Reanimated":
                return name + " (R)";
            default:
                return name;
        }
    }

    const visiblesSet = new Set(visibles);
    /**
     * @param {string[]} x
     * @returns {string[]}
     */
    function filterClasses(x) {
        return x.filter((y) => visiblesSet.has(y));
    }

    /**
     * @param {Chakra} chakra
     * @return {HTMLElement}
     */
    function renderChakra(chakra) {
        const el = document.createElement("div");
        el.className = `chakra ${chakra}`;
        return el;
    }

    /**
     * @param {Chakras} cost
     * @return {HTMLElement[]}
     */
    function renderCost(cost) {
        return Object.entries(cost).flatMap(([chakra, amount]) =>
            Array.from(Array(amount), () => renderChakra(chakra)),
        );
    }

    /**
     * @param {Skill} skill
     * @return {HTMLElement}
     */
    function renderClasses({ classes, dur: { tag } }) {
        const el = document.createElement("p");
        el.className = "skillClasses";
        if (tag === "Passive") {
            tag = "Instant";
        }
        el.innerText = [tag, ...filterClasses(classes)].join(", ");
        return el;
    }

    /**
     * @param {string} text
     * @return {HTMLElement}
     */
    function renderExtra(text) {
        const el = document.createElement("span");
        el.className = "extra";
        el.innerText = text;
        return el;
    }

    const tooltip = document.getElementById("tooltip");
    tooltip.hidden = true;

    /** @type {HTMLElement|undefined} */
    let currentTooltip = undefined;

    function hideTooltip() {
        tooltip.hidden = true;
    }

    /**
     * @param {(tooltip: Tooltip, el: HTMLElement) => void} render
     * @returns {(ev: MouseEvent) => void}
     */
    function wrapTooltipRenderer(render) {
        return (ev) => {
            /** @type {HTMLElement} */
            const el = ev.currentTarget;
            if (!tooltip.hidden && currentTooltip === el) {
                return;
            }
            tooltip.hidden = true;
            currentTooltip = el;
            const [header, article] = tooltip.children;
            render({ header, article }, el);
            tooltip.style.left =
                Math.min(ev.pageX, document.body.scrollWidth - tooltip.clientWidth - 10) + "px";
            tooltip.style.top =
                Math.min(el.offsetTop, document.body.scrollHeight - tooltip.clientHeight - 10) +
                "px";
            tooltip.hidden = false;
        };
    }

    const characterTooltipHandler = wrapTooltipRenderer(({ header, article }, el) => {
        const character = findCharacter(el);
        if (!character) {
            return;
        }
        header.innerText = formatCharacterName(character);
        article.innerText = character.bio;
    });

    const skillTooltipHandler = wrapTooltipRenderer(({ header, article }, el) => {
        const skill = findSkill(el);
        if (!skill) {
            return;
        }
        const { charges, cooldown, cost } = skill;
        header.innerText = skill.name;
        header.append(...renderCost(cost), document.createElement("br"), renderClasses(skill));

        article.innerHTML = skill.desc.replace(/(\[.\]|\[|\])/g, (text) => {
            if (text === "[") {
                return "<i>";
            }
            if (text === "]") {
                return "</i>";
            }
            if (text === "[b]") {
                return "<div class='chakra blood'></div>";
            }
            if (text === "[g]") {
                return "<div class='chakra gen'></div>";
            }
            if (text === "[n]") {
                return "<div class='chakra nin'></div>";
            }
            if (text === "[t]") {
                return "<div class='chakra tai'></div>";
            }
            if (text === "[r]") {
                return "<div class='chakra rand'></div>";
            }
            return text;
        });

        if (charges === 1) {
            article.append(renderExtra("1 charge."));
        } else if (charges > 1) {
            article.append(renderExtra(`${charges} charges.`));
        }
        if (cooldown > 0) {
            article.append(renderExtra(`CD: ${(cooldown / 2) | 0}`));
        }
    });

    const characterLinks = [
        ...document.querySelectorAll("a.name"),
        ...document.querySelector("li").querySelectorAll("sup"),
        ...document.querySelectorAll(".head"),
    ];
    const skillLinks = document.querySelectorAll(".skill");

    for (el of characterLinks) {
        el.addEventListener("mouseover", characterTooltipHandler);
        el.addEventListener("mouseleave", hideTooltip);
    }

    for (el of skillLinks) {
        el.addEventListener("mouseover", skillTooltipHandler);
        el.addEventListener("mouseleave", hideTooltip);
    }
});
