<article>
  <section>
    <img .char.avatar src=#{avatar}>
    $if not $ null team
      <div .team>
        $forall char <- team
          ^{Link.head char}
  <dl>
    <h3>#{name}
    <dt>Rank
    <dd .#{rank}>#{rank}
    <dt>Clan
    <dd>#{fromMaybe "Clanless" clan}
    <dt>Joined
    <dd>#{show joined}
    <dt>Level
    <dd>
      <div .levelBg style="width: #{quot xp 5000}%;">
      <div .levelText>#{level}
    <dt>XP
    <dd>#{xp}
    <dt>Wins
    <dd>#{wins}
    <dt>Losses
    <dd>#{losses}
    <dt>Streak
    <dd>#{streak}
    <dt>Record
    <dd>#{record}
