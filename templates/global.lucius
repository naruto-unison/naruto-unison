:root {
    --action: #09f;
    --button-bg: #dfdfdf;
    --button-hover: #ccc;
    --chakra-blood: #f0000a;
    --chakra-gen: #fff;
    --chakra-nin: #00a9d5;
    --chakra-tai: #0cdd2c;
    --chakra-rand: #000;
    --danger: #e00;
    --desc-extra: #606060;
    --rank-admin: #151c77;
    --rank-moderator: #2d7715;
}

a {
    text-decoration: none;

    &:active,
    &:focus {
        outline-style: none;
    }

    sup {
        text-decoration: none;
    }
}

body,
html {
    width: 100%;
    height: 100%;
}

dl {
    margin-top: 0;
}
dt {
    float: left;
    width: 6.5em;
    font-weight: bold;
}
dt::after {
    content: ":";
}
dd {
    margin-bottom: 0.25em;
    margin-left: 6.5em;
}

h1,
h2 {
    text-transform: uppercase;
}
h2,
h3,
h4 {
    margin-bottom: 0.3em;
}
h3,
h4 {
    margin-top: 0.5em;
}
h1 {
    font-size: 1.6em;
    text-align: center;
}
h3 {
    font-size: 1.25em;
}
h4 {
    font-size: 1.15em;
}

i {
    color: #600;
}

input,
textarea {
    background-color: #ddd;
    border: 1px solid #888;
}

ol,
ul {
    li {
        margin-top: 0.5em;
        line-height: 1.4em;

        > dt,
        > dd {
            display: contents;
        }
    }
}

sup {
    font-style: italic;
    font-size: 0.7em;
    display: inline-block;
    text-decoration: none !important;
}

ul {
    margin: 0;
    padding: 0 1em;

    ul {
        padding-left: 1.5em;
        padding-bottom: 0.2em;
    }
}

.chakra {
    display: inline-block;
    height: 0.6em;
    width: 0.6em;
    border: 1px solid #222;
    margin-left: 3px;

    &.blood {
        background-color: var(--chakra-blood) !important;
    }
    &.gen {
        background-color: var(--chakra-gen) !important;
    }
    &.nin {
        background-color: var(--chakra-nin) !important;
    }
    &.tai {
        background-color: var(--chakra-tai) !important;
    }
    &.rand {
        background-color: var(--chakra-rand) !important;
    }
}

.char {
    display: inline-block;
    outline: 1px solid #000;
    margin: 5px;
    vertical-align: top;
}

.complete {
    color: rgb(0, 150, 0);
}
.incomplete {
    color: rgb(200, 0, 0);
}

.extra {
    color: #606060;
    margin-left: 0.4em;
}

.skillClasses {
    font-weight: normal;
    color: var(--desc-extra);
}

.space {
    flex-grow: 1;
}

.wrap {
    white-space: nowrap;
}

.admin {
    color: var(--rank-admin);
    border-color: var(--rank-admin);
    outline-color: var(--rank-admin);
}
.moderator {
    color: var(--rank-moderator);
    border-color: var(--rank-moderator);
    outline-color: var(--rank-moderator);
}
